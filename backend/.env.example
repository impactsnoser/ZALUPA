# Строка подключения к Postgres (Neon, Supabase, Railway и т.п.).
# Пример: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Токен бота из @BotFather. Нужен для проверки подписи Telegram initData
# и для счетов Telegram Stars.
TELEGRAM_BOT_TOKEN=

# Разрешить запросы без initData. Для локальной разработки — 1,
# в проде с токеном — 0 (или не задавать: тогда 0).
ALLOW_DEV_AUTH=1

# Сколько секунд считать initData свежими (по умолчанию сутки).
TELEGRAM_AUTH_MAX_AGE=86400

# Домен фронтенда для CORS. Несколько — через запятую.
# Пусто = разрешить все (удобно на старте, но лучше задать).
FRONTEND_ORIGIN=

# Публичный адрес бэкенда для вебхука Telegram.
# На Railway обычно подставляется из RAILWAY_PUBLIC_DOMAIN автоматически.
PUBLIC_BASE_URL=

# Секрет вебхука Telegram. Если пусто — выводится из токена бота.
TELEGRAM_WEBHOOK_SECRET=

# Отключить автоматическую регистрацию вебхука (1 — отключить).
TELEGRAM_WEBHOOK_DISABLED=0

# Единый баланс: сколько внутренних звёзд даёт 1 TON.
STARS_PER_TON=100

# Приветственный баланс нового игрока (в звёздах).
WELCOME_STARS=1000

# Пополнение TON: адрес кошелька проекта. Пока пусто — способ недоступен.
TON_DEPOSIT_ADDRESS=

# Необязательный ключ toncenter.com (без него есть лимит запросов).
TONCENTER_API_KEY=

# Сколько живёт счёт на перевод TON (секунды).
TON_DEPOSIT_TTL_SECONDS=3600

# Границы пополнения TON.
MIN_TON_DEPOSIT=0.5
MAX_TON_DEPOSIT=1000
